# ── ActivePaws Backend - Variables de entorno ──────────────────────────────────
# Copia este archivo como .env en la carpeta backend/

PORT=4000

# Cadena de conexión a MongoDB.
# Local:  mongodb://127.0.0.1:27017/activepaws
# Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/activepaws
MONGODB_URI=mongodb://127.0.0.1:27017/activepaws

# Clave secreta para firmar los JWT
# IMPORTANTE: Cámbiala por una cadena larga y aleatoria en producción
JWT_SECRET=activepaws_super_secret_jwt_key_2024

# URL del frontend (usada para el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# ── Envío real de correos (SMTP) ────────────────────────────────────────────
# Si dejas estas variables vacías, el backend imprime el código en su consola
# en lugar de enviarlo (para poder probar el proyecto sin credenciales).
#
# Ejemplo con Gmail:
#   1. Activa la verificación en dos pasos en tu cuenta de Gmail.
#   2. Genera una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#   3. Usa esa contraseña (no la de tu cuenta) en SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ActivePaws <tu_correo@gmail.com>"
